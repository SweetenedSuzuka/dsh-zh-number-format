{
  "name": "dsh-zh-number-format",
  "version": "1.0.1",
  "description": "DSH插件：将DSH的数字显示格式改为中文的显示格式（DSH plugin: format numbers in Chinese numerals）",
  "license": "GPL-2.0",
  "author": "SweetenedSuzuka <suzuka.nagami@outlook.com>",
  "repository": { "type": "git", "url": "git+https://github.com/SweetenedSuzuka/dsh-zh-number-format.git" },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
